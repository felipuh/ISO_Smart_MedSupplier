# ISO Smart MedSupplier backend environment example
#
# Copy to backend/.env for local development. Do not commit real secrets.

# Runtime
DJANGO_ENV=
DEBUG=
SECRET_KEY=
ALLOWED_HOSTS=

# Smart3AI/AdminApps identity
SMART3AI_SSO_JWT_SECRET=
SMART3AI_SSO_ISSUER=
SMART3AI_SSO_AUDIENCE=

# AdminApps integration
ADMIN_APPS_BASE_URL=
ADMIN_APPS_API_KEY=
ADMIN_APPS_TIMEOUT=
ADMIN_APPS_CACHE_TTL=
ADMIN_APPS_SYNC_USERS=
ADMIN_APPS_REQUIRE_IDENTITY_SOURCE=
ADMIN_APPS_ALLOW_LOCAL_FALLBACK=

# MedSupplier packaging
# Allowed values currently used by code: standalone, integrated.
MEDSUPPLIER_PRODUCT_MODE=

# Owner/demo organization controls
OWNER_ORGANIZATION_ONLY_ACCESS=
OWNER_ORGANIZATION_SLUG=
OWNER_ORGANIZATION_NAME=
OWNER_ORGANIZATION_EXTERNAL_ID=
OWNER_ORGANIZATION_BILLING_EXEMPT=
ALLOW_LOCAL_AUTH_BYPASS_FOR_TESTS=

# Primary database
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
DB_CONN_MAX_AGE=

# Optional AI database
AI_DB_NAME=
AI_DB_USER=
AI_DB_PASSWORD=
AI_DB_HOST=
AI_DB_PORT=

# Optional audit database
AUDIT_DB_NAME=
AUDIT_DB_USER=
AUDIT_DB_PASSWORD=
AUDIT_DB_HOST=
AUDIT_DB_PORT=

# Browser/API security for local development
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=
SESSION_COOKIE_SECURE=
CSRF_COOKIE_SECURE=
SECURE_SSL_REDIRECT=
SECURE_HSTS_SECONDS=
SECURE_HSTS_INCLUDE_SUBDOMAINS=
SECURE_HSTS_PRELOAD=
THROTTLE_ANON_RATE=
THROTTLE_USER_RATE=

# Email and user flows
DEFAULT_FROM_EMAIL=
FRONTEND_BASE_URL=
PASSWORD_RESET_TOKEN_EXPIRY_MINUTES=
PASSWORD_RESET_WINDOW_MINUTES=
PASSWORD_RESET_MAX_REQUESTS_PER_HOUR=
PASSWORD_HISTORY_COUNT=
TEMP_PASSWORD_MAX_AGE_DAYS=
TEMP_PASSWORD_WARNING_DAYS=
LOGIN_MAX_ATTEMPTS=
LOGIN_LOCKOUT_MINUTES=

# Logs
ISOSMART_LOG_DIR=

# Production-like example overrides
#
# DJANGO_ENV=production
# DEBUG=False
# SECRET_KEY=replace_with_long_random_secret_from_secret_manager
# ALLOWED_HOSTS=medsupplier.smart3ai.local,medsupplier.isosmart.local
# CORS_ALLOWED_ORIGINS=https://medsupplier.smart3ai.local
# CSRF_TRUSTED_ORIGINS=https://medsupplier.smart3ai.local
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=False
# ADMIN_APPS_ALLOW_LOCAL_FALLBACK=False

# AI assistant provider, optional for local validation
AI_ASSISTANT_API_URL=
AI_ASSISTANT_API_KEY=
AI_ASSISTANT_MODEL=
AI_ASSISTANT_SUPPORTED_STANDARDS=
AI_ASSISTANT_SYSTEM_PROMPT=
