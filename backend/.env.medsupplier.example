# ===============================
# ISO Smart MedSupplier Environment
# ===============================

# Product mode:
# standalone = sold/operated separately from Iso Smart, but still governed by AdminApps
# integrated = sold together with Iso Smart and shares QMS evidence flows
MEDSUPPLIER_PRODUCT_MODE=

ENVIRONMENT=
DEBUG=
SECRET_KEY=
ALLOWED_HOSTS=

# Shared SSO uses AdminApps as the identity/business authority.
SMART3AI_SSO_JWT_SECRET=
SMART3AI_SSO_ISSUER=

# Standalone database recommendation.
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Optional separated stores.
AI_DB_NAME=
AI_DB_USER=
AI_DB_PASSWORD=
AI_DB_HOST=
AI_DB_PORT=
AUDIT_DB_NAME=
AUDIT_DB_USER=
AUDIT_DB_PASSWORD=
AUDIT_DB_HOST=
AUDIT_DB_PORT=

# AdminApps is the business brain for every Smart3AI product:
# organizations, users, roles, subscriptions and module entitlements are created there.
ADMIN_APPS_BASE_URL=
ADMIN_APPS_API_KEY=
ADMIN_APPS_TIMEOUT=
ADMIN_APPS_CACHE_TTL=
ADMIN_APPS_SYNC_USERS=
ADMIN_APPS_REQUIRE_IDENTITY_SOURCE=

CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=
SESSION_COOKIE_SECURE=
CSRF_COOKIE_SECURE=
THROTTLE_ANON_RATE=
THROTTLE_USER_RATE=
